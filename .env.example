# postgresql+psycopg://USER:PASSWORD@localhost:5432/youareunstoppable
# On Vercel, paste POSTGRES_URL here. postgres:// is rewritten to postgresql+psycopg://.
DATABASE_URL=

# Long random string. Used to sign access tokens.
JWT_SECRET=

# Same value as the frontend's GOOGLE_CLIENT_ID. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=

# Optional. Defaults are 15 minutes, 30 days, and false.
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=30
# COOKIE_SECURE=false

# Billing. Leave any of these empty and Monthly Pro stays hidden. Checkout then returns 503.
# STRIPE_SECRET_KEY is the secret key (sk_test_... or sk_live_...).
# STRIPE_WEBHOOK_SECRET is the webhook signing secret (whsec_...).
# STRIPE_PRICE_ID is the monthly Price id from the Stripe Dashboard (price_...).
# FRONTEND_ORIGIN is where Checkout and the portal send the browser back. Locally: http://localhost:5173
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
FRONTEND_ORIGIN=

# Coach. Leave AI_API_KEY empty and talking with the coach returns 503. Applying a stored proposal does not need it.
# AI_MODEL overrides the chat model. The default is gpt-4o-mini.
AI_API_KEY=
# AI_MODEL=gpt-4o-mini

