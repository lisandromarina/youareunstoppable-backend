# postgresql+psycopg://USER:PASSWORD@localhost:5432/youareunstoppable
DATABASE_URL=

# Long random string. Used to sign access tokens.
JWT_SECRET=

# Same value as the frontend's VITE_GOOGLE_CLIENT_ID. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=

# Optional. Defaults are 15 minutes, 30 days, and false.
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=30
# COOKIE_SECURE=false
